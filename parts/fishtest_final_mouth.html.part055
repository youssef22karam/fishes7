-monospace,SFMono-Regular,monospace;color:var(--acc)}.adaptation p{font-size:11px;color:var(--mut);line-height:1.6;margin:2px 0 6px}.adaptation input[type=range]{width:100%;max-width:none;padding:0;border:0;min-height:25px;accent-color:var(--acc);background:none}.gene-lock{color:var(--mut);font-size:10px}.god-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:15px}.god-actions button{flex:1;font-size:12px}.panel-note{border-left:2px solid var(--acc);padding:7px 12px;font-size:11px;color:var(--mut);line-height:1.6;margin:15px 0}.camera-row{display:flex;gap:5px;margin-block:15px}.camera-row button{flex:1;font-size:11px;min-height:31px}.bar.top{gap:4px}.bar.top select{flex:0 1 150px;min-width:105px;max-width:175px}.bar.top #selSpecies{flex-basis:175px}.bar.top #seed{flex:0 0 76px;width:76px!important}.bar.top #nameInput{flex:0 1 208px;width:208px!important;min-width:118px}.bar.top #btnRandom{flex:none}@keyframes sheetIn{0%{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}@media(min-width:1000px){#sheet{top:calc(68px + var(--sat));right:0;bottom:calc(58px + var(--sab));width:420px;max-height:none;border-left:1px solid var(--line);border-top:0}#gl{transition:width .2s ease}}@media(max-width:700px){.brand{font-size:17px;margin-right:5px}.bar.top{min-height:calc(61px + var(--sat));padding-top:calc(8px + var(--sat));padding-bottom:8px}.bar select{font-size:11px;padding:6px;max-width:150px}#hud{left:15px;top:calc(86px + var(--sat))}#fishName{font-size:22px}#fishTags{font-size:10px;max-width:85vw}#seed{display:none}.bar.bottom button{padding-inline:10px}#sheet{max-height:65vh}#btnGenerate{font-size:12px}}@media(prefers-reduced-motion:reduce){*,#gl{animation:none!important;transition:none!important}}.bar.top #selMix{flex:0 1 150px;min-width:98px}.bar.top #mixRatio{flex:0 0 60px;width:60px!important}.bar.top #btnMix{flex:none}.evo-row{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:12px}.evo-lab{flex:0 0 46%;color:var(--txt)}.bar-prog{flex:1;height:6px;background:#ffffff1a;border-radius:3px;overflow:hidden}.bar-prog i{display:block;height:100%;background:var(--acc)}.evo-pct{flex:0 0 34px;text-align:right;color:var(--mut)}.evo-chips{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}.evo-chips button{white-space:normal;text-align:left}.pg-card{border:1px solid var(--line);border-radius:10px;padding:8px 10px;background:#88dfbf0f;margin-bottom:8px}.pg-name{font-size:16px;font-weight:700}.pg-sci{font-style:italic;color:var(--mut);font-size:12px;margin-bottom:4px}.pg-tags{display:flex;gap:4px;flex-wrap:wrap}.pg-tags .chip{cursor:default}.pg-hint{font-size:11px;color:var(--mut);margin:2px 0 4px}#pgSeed,#pgPartner{font-family:ui-monospace,SFMono-Regular,monospace;letter-spacing:.06em;text-transform:uppercase}.thumb.sel{outline:2px solid var(--acc)}#btnProc{margin-right:2px}.row select#pgClade{max-width:100%;min-width:0;flex:1 1 100%}.legacy,#stats,#fishTags{display:none!important}#poof{position:fixed;left:50%;top:46%;width:0;height:0;z-index:6;pointer-events:none}#poof i{position:absolute;left:0;top:0;display:block;pointer-events:none;will-change:transform,opacity;animation-fill-mode:forwards;animation-timing-function:cubic-bezier(.15,.8,.3,1)}.pf-puff{width:var(--sz);height:var(--sz);margin:calc(var(--sz)/-2) 0 0 calc(var(--sz)/-2);border-radius:50%;background:radial-gradient(circle,hsla(var(--hue),70%,92%,.55),hsla(var(--hue),65%,78%,.28) 45%,hsla(var(--hue),60%,70%,0) 70%);animation-name:pfPuff}.pf-bub{width:var(--sz);height:var(--sz);margin:calc(var(--sz)/-2) 0 0 calc(var(--sz)/-2);border-radius:50%;border:1.5px solid rgba(220,250,255,.85);background:#dcfaff1f;animation-name:pfBub}.pf-star{width:var(--sz);height:var(--sz);margin:calc(var(--sz)/-2) 0 0 calc(var(--sz)/-2);background:hsl(var(--hue),95%,82%);clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);animation-name:pfStar}.pf-ring{width:var(--sz);height:var(--sz);margin:calc(var(--sz)/-2) 0 0 calc(var(--sz)/-2);border-radius:50%;border:3px solid rgba(160,245,230,.8);animation-name:pfRing}@keyframes pfPuff{0%{transform:translate(0) scale(.15);opacity:0}18%{opacity:1}to{transform:translate(var(--dx),var(--dy)) scale(var(--s));opacity:0}}@keyframes pfBub{0%{transform:translate(0) scale(.3);opacity:0}15%{opacity:1}to{transform:translate(var(--dx),var(--dy)) scale(1);opacity:0}}@keyframes pfStar{0%{transform:translate(0) scale(0) rotate(0);opacity:1}to{transform:translate(var(--dx),var(--dy)) scale(1.1) rotate(120deg);opacity:0}}@keyframes pfRing{0%{transform:scale(.1);opacity:.9}to{transform:scale(2.3);opacity:0}}.brandmark{position:fixed;left:calc(22px + var(--sal));top:calc(18px + var(--sat));z-index:5;font:700 18px/1.1 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;letter-spacing:.01em;color:var(--txt);text-shadow:0 1px 3px #000;pointer-events:none}.brandmark small{display:block;margin-top:3px;font:500 10px/1 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);opacity:.85}#hud{left:calc(22px + var(--sal))!important;top:calc(74px + var(--sat))!important;max-width:min(560px,calc(100vw - 44px))!important}#hud #fishName{font-size:clamp(24px,4.4vw,38px)}.dock{position:fixed;left:50%;bottom:calc(22px + var(--sab));transform:translate(-50%);z-index:7;width:min(560px,calc(100vw - 28px));display:flex;flex-direction:column;gap:10px;padding:14px;border-radius:22px;background:#08121c9e;border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(16px) saturate(1.3);-webkit-backdrop-filter:blur(16px) saturate(1.3);box-shadow:0 18px 50px #00000073}.dock-caption{text-align:center;font-size:12px;color:var(--mut);min-height:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dock .mega{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:60px;padding:0 20px;border:0;border-radius:16px;font:700 19px/1 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#05231d;background:linear-gradient(135deg,#7ff0cf,#3cc8e6);box-shadow:0 8px 26px #3cc8e659,inset 0 1px #ffffff80;cursor:pointer;transition:transform .12s ease,box-shadow .2s ease,filter .2s}.dock .mega:hover{transform:translateY(-1px);filter:brightness(1.06);box-shadow:0 12px 32px #3cc8e680,inset 0 1px #ffffff80}.dock .mega:active{transform:scale(.98)}.mega-ico{font-size:22px}.env-row{display:flex;gap:10px;align-items:stretch}.env{flex:1 1 55%;display:flex;flex-direction:column;gap:3px;min-width:0}.env span{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);padding-left:4px}.dock select{width:100%;min-height:44px;padding:0 12px;border-radius:12px;font-size:14px}.dock .explore{flex:1 1 45%;align-self:flex-end;min-height:44px;padding:0 14px;border-radius:12px;font-size:14px;font-weight:600;color:var(--acc);background:#88dfbf1a;border:1px solid rgba(136,223,191,.45);cursor:pointer;transition:background .2s,transform .12s}.dock .explore:hover{background:#88dfbf33}.dock .explore:active{transform:scale(.97)}#toast{bottom:calc(210px + var(--sab))!important}#gl.fish-out{animation:fishOut .22s ease-in both}#gl.fish-in{animation:fishIn .5s cubic-bezier(.2,.9,.25,1.12) both}@keyframes fishOut{to{opacity:0;transform:scale(.82)}}@keyframes fishIn{0%{opacity:0;transform:scale(.78)}60%{opacity:1}to{opacity:1;transform:scale(1)}}@media(max-width:520px){.env-row{flex-direction:column}.dock .explore{align-self:stretch}.env span{display:none}.dock .mega{min-height:54px;font-size:17px}}.dock select,.dock button{max-width:none}</style>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
